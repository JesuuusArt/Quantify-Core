  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token emitido por Keycloak mediante OIDC; la API valida emisor, audiencia, firma, vigencia, rol y pertenencia. No usar ID token."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "URI del tipo de problema o about:blank"
          },
          "title": {
            "type": "string",
            "description": "Resumen seguro"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "Explicación sin información sensible"
          },
          "code": {
            "type": "string",
            "description": "Código estable para cliente"
          },
          "requestId": {
            "type": "string",
            "description": "Identificador no sensible de correlación"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Nombre de campo"
                },
                "code": {
                  "type": "string",
                  "description": "Código de validación"
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timeZone": {
            "type": "string",
            "description": "Identificador de zona IANA; validar contra base IANA"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "admin"
              ]
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          }
        },
        "required": [
          "id",
          "timeZone",
          "roles",
          "status"
        ],
        "description": "Perfil de negocio propio; la identidad y credenciales son de Keycloak"
      },
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "description": "Fecha de negocio YYYY-MM-DD"
          }
        },
        "required": [
          "weekdays",
          "effectiveFrom"
        ],
        "description": "Lunes=1 a domingo=7; cambios futuros crean revisión"
      },
      "HabitCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "targetValue": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "description": "Unidad; catálogo pendiente",
            "minLength": 1
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "timeZone": {
            "type": "string",
            "description": "Identificador de zona IANA; validar contra base IANA"
          }
        },
        "required": [
          "name",
          "targetValue",
          "unit",
          "schedule",
          "timeZone"
        ],
        "description": "Crear un hábito personal; dueño derivado del token"
      },
      "HabitPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "targetValue": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "description": "Unidad",
            "minLength": 1
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "timeZone": {
            "type": "string",
            "description": "Identificador de zona IANA; validar contra base IANA"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "archived"
            ]
          }
        },
        "required": [],
        "description": "Al menos un campo; la API valida transiciones y vigencia futura",
        "minProperties": 1
      },
      "Habit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Nombre",
            "minLength": 1
          },
          "targetValue": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "description": "Unidad",
            "minLength": 1
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "timeZone": {
            "type": "string",
            "description": "Identificador de zona IANA; validar contra base IANA"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "archived"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante UTC RFC 3339 con Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante UTC RFC 3339 con Z"
          }
        },
        "required": [
          "id",
          "name",
          "targetValue",
          "unit",
          "schedule",
          "timeZone",
          "status",
          "version",
          "createdAt",
          "updatedAt"
        ]
